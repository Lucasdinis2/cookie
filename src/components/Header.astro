---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site.mjs';

const links = [
  { href: '#inicio', label: 'Início' },
  { href: '#sabores', label: 'Nossos sabores' },
  { href: '#sobre', label: 'Sobre nós' },
  { href: '#pedidos', label: 'Pedidos' },
];
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href="#inicio" class="site-header__logo" aria-label="MOKKI Cookies — voltar ao início">
      <Logo variant="full" />
    </a>

    <nav class="site-nav" aria-label="Navegação principal">
      <ul class="site-nav__list" data-nav>
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="site-nav__link" data-nav-link={l.href.slice(1)}>
                {l.label}
              </a>
            </li>
          ))
        }
        <span class="site-nav__pill" aria-hidden="true" data-nav-pill></span>
      </ul>
    </nav>

    <a href="#pedidos" class="site-header__cta">
      <Icon name="bag" size={20} />
      <span>Fazer pedido</span>
      <span class="cart-badge" data-cart-count hidden aria-live="polite"></span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label>Abrir menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <div class="mobile-menu__stripes" aria-hidden="true"></div>
  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <nav aria-label="Navegação do menu">
      <ul class="mobile-menu__list">
        {
          links.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href} data-menu-link>
                <span class="mobile-menu__num">0{i + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <a href="#pedidos" class="btn btn--block" data-menu-link>
        <Icon name="bag" /> Fazer meu pedido
      </a>
      <p class="mobile-menu__place"><Icon name="pin" size={18} /> Entregamos em {SITE.city} – {SITE.state}</p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding: 12px var(--gutter);
    transition: transform 0.5s var(--ease-out);
    pointer-events: none;
  }
  .site-header__inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: var(--maxw);
    height: calc(var(--header-h) - 24px);
    margin: 0 auto;
    padding: 0 10px 0 22px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out);
  }
  .site-header.is-solid .site-header__inner {
    background: rgb(255 248 220 / 0.78);
    border-color: rgb(73 43 39 / 0.08);
    box-shadow: 0 8px 30px rgb(73 43 39 / 0.1);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  .site-header.is-hidden {
    transform: translateY(-120%);
  }
  .site-header__logo {
    width: 104px;
    flex: none;
    transition: transform 0.4s var(--ease-spring);
  }
  .site-header__logo:hover {
    transform: rotate(-3deg) scale(1.04);
  }

  .site-nav {
    margin-inline: auto;
  }
  .site-nav__list {
    position: relative;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 5px;
    list-style: none;
    border-radius: 999px;
  }
  .site-nav__link {
    position: relative;
    z-index: 1;
    display: block;
    padding: 9px 18px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 550;
    color: var(--brown);
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }
  .site-nav__link[aria-current='true'] {
    color: var(--cream);
  }
  .site-nav__pill {
    position: absolute;
    top: 5px;
    left: 0;
    height: calc(100% - 10px);
    width: 0;
    border-radius: 999px;
    background: var(--brown);
    opacity: 0;
    transition:
      transform 0.55s var(--ease-spring),
      width 0.55s var(--ease-spring),
      opacity 0.3s;
  }

  .site-header__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--brown);
    color: var(--cream);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.35s var(--ease-spring),
      background 0.3s;
  }
  .site-header__cta:hover {
    transform: translateY(-2px) rotate(-1.5deg);
    background: var(--teal);
  }
  .cart-badge {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--brown);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .cart-badge.bump {
    animation: bump 0.5s var(--ease-spring);
  }
  @keyframes bump {
    40% {
      transform: scale(1.45);
    }
  }

  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--brown);
    color: var(--cream);
    place-items: center;
  }
  .menu-toggle__bars {
    position: relative;
    width: 20px;
    height: 12px;
  }
  .menu-toggle__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-spring),
      top 0.3s var(--ease-out);
  }
  .menu-toggle__bars span:first-child {
    top: 0;
  }
  .menu-toggle__bars span:last-child {
    top: 10px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
    top: 5px;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  /* ---------- Menu mobile ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: grid;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__stripes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--brown) 0 18px, var(--blue) 18px 36px);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.55s var(--ease-out);
  }
  .mobile-menu__panel {
    position: relative;
    margin: 86px 12px 12px;
    padding: 28px 24px 24px;
    border-radius: var(--radius-l);
    background: var(--cream);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-m);
    clip-path: inset(0 0 100% 0 round 34px);
    transition: clip-path 0.6s var(--ease-out) 0.08s;
    overflow: auto;
  }
  .mobile-menu.is-open .mobile-menu__stripes {
    clip-path: inset(0 0 0 0);
  }
  .mobile-menu.is-open .mobile-menu__panel {
    clip-path: inset(0 0 0 0 round 34px);
  }
  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu__list li {
    border-bottom: 1px solid rgb(73 43 39 / 0.12);
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.5s var(--ease-spring);
    transition-delay: calc(0.18s + var(--i) * 0.06s);
  }
  .mobile-menu.is-open .mobile-menu__list li {
    opacity: 1;
    transform: none;
  }
  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 16px 4px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 2.6rem);
    font-weight: 600;
    color: var(--brown);
    text-decoration: none;
  }
  .mobile-menu__num {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--teal);
  }
  .mobile-menu__foot {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }
  .mobile-menu__place {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--teal);
  }

  @media (max-width: 920px) {
    .site-nav,
    .site-header__cta {
      display: none;
    }
    .menu-toggle {
      display: grid;
      margin-left: auto;
    }
    .site-header__inner {
      padding: 0 6px 0 18px;
    }
    .site-header__logo {
      width: 92px;
    }
  }
</style>
