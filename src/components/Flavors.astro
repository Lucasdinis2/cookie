---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { FLAVORS } from '../data/flavors';
import { SITE } from '../config/site.mjs';

const money = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: SITE.currency });
---

<section id="sabores" class="flavors" aria-labelledby="sabores-title">
  <div class="flavors__decor" aria-hidden="true">
    <span class="chip-deco" data-float="0.6" style="--x: 6%; --y: 14%; --s: 1"></span>
    <span class="chip-deco" data-float="1.2" style="--x: 92%; --y: 8%; --s: 0.7"></span>
    <span class="chip-deco" data-float="0.9" style="--x: 88%; --y: 62%; --s: 1.2"></span>
    <span class="chip-deco" data-float="1.4" style="--x: 4%; --y: 76%; --s: 0.6"></span>
  </div>

  <div class="container">
    <header class="flavors__head">
      <p class="flavors__kicker script" data-reveal>Agora vem a melhor parte...</p>
      <h2 id="sabores-title" class="section-title">
        <span class="mask-line"><span data-split-line>Conheça nossos</span></span>
        <span class="mask-line"><span data-split-line>sabores!</span></span>
      </h2>
      <p class="lead" data-reveal>
        Quatro cookies recheados, feitos com carinho. Escolha o seu (ou os quatro!) e monte seu pedido.
      </p>
    </header>

    <div class="flavors__track" data-flavor-track>
      <ul class="flavors__grid" role="list">
        {
          FLAVORS.map((f, i) => (
            <li class={`flavor flavor--${f.theme}`} data-flavor-card style={`--i:${i}`}>
              <article aria-labelledby={`flavor-${f.id}`}>
                <div class="flavor__media flavor__media--cutout" data-tilt>
                  <Image
                    src={f.image}
                    alt={f.imageAlt}
                    widths={[360, 540, 720, 900]}
                    sizes="(max-width: 768px) 60vw, 380px"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="flavor__num" aria-hidden="true">
                    Nº {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flavor__qty" data-flavor-qty={f.id} hidden />
                </div>
                <div class="flavor__body">
                  <h3 id={`flavor-${f.id}`} class="flavor__name script">
                    {f.name}
                  </h3>
                  <p class="flavor__desc">{f.description}</p>
                  {(f.price != null || f.size) && (
                    <p class="flavor__meta">
                      {f.price != null && <strong>{money.format(f.price)}</strong>}
                      {f.size && <span>{f.size}</span>}
                    </p>
                  )}
                  {f.available ? (
                    <button type="button" class="flavor__add" data-add-flavor={f.id} data-flavor-name={f.name}>
                      <span class="flavor__add-icon">
                        <Icon name="plus" size={18} />
                      </span>
                      <span>Pedir este sabor</span>
                    </button>
                  ) : (
                    <p class="flavor__soon">Indisponível no momento</p>
                  )}
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flavors__dots" aria-hidden="true" data-flavor-dots>
      {FLAVORS.map((_, i) => <span class={i === 0 ? 'is-active' : ''} />)}
    </div>

  </div>

  <div class="toast" role="status" aria-live="polite" data-toast hidden>
    <Icon name="check" size={18} />
    <span data-toast-text></span>
    <a href="#pedidos" class="toast__link">Ver pedido</a>
  </div>
</section>

<style>
  .flavors {
    position: relative;
    padding: clamp(80px, 12vw, 150px) 0 clamp(70px, 10vw, 130px);
    background: var(--cream);
    overflow: clip;
  }
  .flavors__head {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
    margin-bottom: clamp(44px, 7vw, 84px);
  }
  .flavors__kicker {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    color: var(--teal);
    line-height: 1;
  }
  .flavors__head .lead {
    text-align: center;
  }

  .flavors__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Ritmo editorial: colunas desencontradas */
  .flavor:nth-child(even) {
    margin-top: clamp(40px, 7vw, 110px);
  }

  .flavor {
    --card-bg: var(--blue);
    --card-fg: var(--brown);
    --card-accent: var(--teal);
    --btn-bg: var(--brown);
    --btn-fg: var(--cream);
    position: relative;
    border-radius: var(--radius-l);
    background: var(--card-bg);
    color: var(--card-fg);
    box-shadow: var(--shadow-s);
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
  }
  .flavor--brown {
    --card-bg: var(--brown);
    --card-fg: var(--cream);
    --card-accent: var(--blue);
    --btn-bg: var(--cream);
    --btn-fg: var(--brown);
  }
  .flavor--cream {
    --card-bg: var(--paper);
    --card-accent: var(--brown-soft);
    outline: 2px solid rgb(73 43 39 / 0.08);
  }
  .flavor--teal {
    --card-bg: var(--teal);
    --card-fg: var(--cream);
    --card-accent: var(--cream);
    --btn-bg: var(--cream);
    --btn-fg: var(--teal);
  }
  .flavor:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-m);
  }
  .flavor article {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 14px;
  }

  .flavor__media {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: calc(var(--radius-l) - 10px);
    overflow: hidden;
    transform-style: preserve-3d;
    background: rgb(0 0 0 / 0.06);
  }
  .flavor__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 1.1s var(--ease-out);
  }
  .flavor:hover .flavor__media :global(img) {
    transform: scale(1.14) rotate(-1.5deg);
  }
  /* Recorte do cookie real flutuando sobre a cor do card */
  .flavor__media--cutout {
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 55% at 50% 45%, rgb(255 255 255 / 0.55), transparent 70%),
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.035) 0 14px, transparent 14px 28px),
      color-mix(in srgb, var(--card-bg) 82%, white);
  }
  .flavor__media--cutout :global(img) {
    width: 76%;
    height: auto;
    object-fit: contain;
    transform: rotate(-8deg);
    filter: drop-shadow(0 22px 22px rgb(40 25 20 / 0.32));
    transition: transform 0.9s var(--ease-spring);
  }
  .flavor:hover .flavor__media--cutout :global(img) {
    transform: rotate(10deg) scale(1.07);
  }
  .flavor__num {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--brown);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .flavor__qty {
    position: absolute;
    right: 14px;
    top: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--brown);
    color: var(--cream);
    font-size: 0.8rem;
    font-weight: 600;
    animation: pop 0.5s var(--ease-spring);
  }
  @keyframes pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  .flavor__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 24px 14px 12px;
  }
  .flavor__name {
    font-size: clamp(2.5rem, 4vw, 3.4rem);
    line-height: 1;
    color: var(--card-fg);
    font-weight: 400;
  }
  .flavor__desc {
    color: var(--card-fg);
    opacity: 0.86;
    max-width: 38ch;
  }
  .flavor__meta {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .flavor__meta span {
    font-family: var(--font-body);
    font-size: 0.9rem;
    opacity: 0.75;
  }
  .flavor__add {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 50px;
    padding: 6px 22px 6px 6px;
    border: 0;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition:
      transform 0.35s var(--ease-spring),
      box-shadow 0.35s var(--ease-out);
  }
  .flavor__add-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--btn-fg);
    color: var(--btn-bg);
    transition: transform 0.5s var(--ease-spring);
  }
  .flavor__add:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgb(0 0 0 / 0.16);
  }
  .flavor__add:hover .flavor__add-icon {
    transform: rotate(90deg) scale(1.08);
  }
  .flavor__add:active {
    transform: scale(0.96);
  }
  .flavor__add.is-added .flavor__add-icon {
    animation: added 0.6s var(--ease-spring);
  }
  @keyframes added {
    50% {
      transform: scale(1.35) rotate(180deg);
    }
  }
  .flavor__soon {
    margin-top: auto;
    font-weight: 600;
    opacity: 0.7;
  }

  .flavors__dots {
    display: none;
  }
  .flavors__note {
    margin-top: 40px;
    text-align: center;
    font-size: 0.8rem;
    color: var(--brown-soft);
    opacity: 0.8;
  }

  /* Gotas de chocolate decorativas */
  .flavors__decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .chip-deco {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(34px * var(--s));
    height: calc(30px * var(--s));
    border-radius: 48% 52% 44% 56% / 58% 50% 50% 42%;
    background: radial-gradient(circle at 35% 30%, #7a4a35, var(--chocolate) 60%);
    box-shadow: inset -3px -4px 6px rgb(0 0 0 / 0.3);
    opacity: 0.9;
  }

  /* Toast */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 12px 12px 18px;
    border-radius: 999px;
    background: var(--brown);
    color: var(--cream);
    box-shadow: var(--shadow-m);
    font-weight: 500;
    translate: -50% 0;
    animation: toast-in 0.5s var(--ease-spring);
  }
  .toast[hidden] {
    display: none;
  }
  .toast__link {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--brown);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  @keyframes toast-in {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
  }

  /* ---------- Mobile: carrossel com snap ---------- */
  @media (max-width: 768px) {
    .flavors__track {
      margin-inline: calc(-1 * var(--gutter));
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
    }
    .flavors__track::-webkit-scrollbar {
      display: none;
    }
    .flavors__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      gap: 14px;
      padding: 8px var(--gutter) 24px;
    }
    .flavor {
      scroll-snap-align: center;
    }
    .flavor:nth-child(even) {
      margin-top: 0;
    }
    .flavor:hover {
      transform: none;
    }
    .flavor__body {
      padding: 18px 8px 8px;
    }
    .flavors__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
    }
    .flavors__dots span {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: rgb(73 43 39 / 0.25);
      transition:
        width 0.4s var(--ease-spring),
        background 0.3s;
    }
    .flavors__dots span.is-active {
      width: 26px;
      background: var(--brown);
    }
    .toast {
      bottom: calc(84px + env(safe-area-inset-bottom));
      width: max-content;
      max-width: calc(100% - 32px);
      font-size: 0.9rem;
    }
  }
</style>
