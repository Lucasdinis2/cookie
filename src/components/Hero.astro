---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import cookieCutout from '../assets/photos/cookie-cutout.png';
import { SITE } from '../config/site.mjs';
---

<section id="inicio" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__bg" aria-hidden="true" data-hero-bg>
      <div class="hero__glow"></div>
    </div>

    <!-- Foto real exibida instantaneamente; o 3D assume quando estiver pronto. -->
    <div class="hero__poster" data-hero-poster aria-hidden="true">
      <Image
        src={cookieCutout}
        alt=""
        widths={[420, 640, 900, 1200]}
        sizes="(max-width: 768px) 78vw, 56vh"
        loading="eager"
        fetchpriority="high"
        format="webp"
      />
    </div>
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>

    <!-- Cena 1 -->
    <div class="hero__intro container" data-hero-intro>
      <p class="eyebrow hero__eyebrow" data-hero-anim>Cookies artesanais · {SITE.city} – {SITE.state}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="mask-line"><span data-hero-line>Tem coisa melhor</span></span>
        <span class="mask-line"><span data-hero-line>que um cookie</span></span>
        <span class="mask-line"><span data-hero-line><em class="script">quentinho?</em></span></span>
      </h1>
      <p class="hero__sub" data-hero-anim>Feito com carinho, recheado de sabor e impossível de comer só um.</p>
      <div class="hero__ctas" data-hero-anim>
        <a href="#historia" class="btn" data-story-play>
          Quero conhecer
          <Icon name="arrow-down" />
        </a>
        <a href="#sabores" class="btn btn--ghost">Ver nossos sabores</a>
      </div>
    </div>

    <div class="hero__hint" data-hero-hint aria-hidden="true">
      <span class="hero__hint-mouse"><span></span></span>
      <span>Role para quebrar o cookie</span>
    </div>

    <!-- Cena 4 -->
    <div class="hero__reveal" id="historia" data-hero-reveal>
      <p class="hero__reveal-a">
        <span class="mask-line"><span data-reveal-line>Por fora,</span></span>
        <span class="mask-line"><span data-reveal-line><em class="script">irresistível.</em></span></span>
      </p>
      <p class="hero__reveal-b">
        <span class="mask-line"><span data-reveal-line>Por dentro,</span></span>
        <span class="mask-line"><span data-reveal-line><em class="script">ainda melhor.</em></span></span>
      </p>
    </div>

    <!-- Progresso da história -->
    <ol class="hero__progress" aria-hidden="true" data-hero-progress>
      <li>Inteiro</li>
      <li>Crec!</li>
      <li>Em pedaços</li>
      <li>Sabores</li>
      <span class="hero__progress-bar"><span data-hero-progress-fill></span></span>
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--blue);
  }
  .hero__stage {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    background: var(--blue);
  }
  .hero__glow {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(40% 40% at 70% 52%, rgb(255 255 255 / 0.55), transparent 70%),
      radial-gradient(30% 30% at 20% 85%, rgb(255 240 189 / 0.35), transparent 70%);
  }

  .hero__poster,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
    touch-action: pan-y;
  }
  .hero.is-3d .hero__canvas {
    opacity: 1;
  }
  .hero__poster {
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity 0.6s var(--ease-out);
  }
  .hero__poster :global(img) {
    width: min(56vh, 46vw);
    height: auto;
    transform: translateX(min(22.5vw, 320px)) rotate(-8deg);
    filter: drop-shadow(0 30px 40px rgb(40 30 40 / 0.22));
    animation: poster-float 5s ease-in-out infinite;
  }
  .hero.is-3d .hero__poster {
    opacity: 0;
  }
  @keyframes poster-float {
    50% {
      translate: 0 -12px;
    }
  }

  /* ---------- Cena 1 ---------- */
  .hero__intro {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    padding-top: var(--header-h);
    pointer-events: none;
  }
  .hero__intro > * {
    pointer-events: auto;
    max-width: 640px;
  }
  .hero__title {
    font-size: clamp(2.8rem, 6.3vw, 6.2rem);
    font-weight: 650;
    line-height: 0.95;
  }
  .hero__title em {
    display: inline-block;
    font-style: normal;
    font-size: 1.12em;
    line-height: 1.05;
    color: var(--teal);
    padding-right: 0.1em;
  }
  .hero__sub {
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    color: var(--brown-soft);
    max-width: 30ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    translate: -50% 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brown);
    opacity: 0.8;
  }
  .hero__hint-mouse {
    width: 22px;
    height: 34px;
    border: 2px solid currentColor;
    border-radius: 12px;
    display: grid;
    justify-items: center;
    padding-top: 6px;
  }
  .hero__hint-mouse span {
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: currentColor;
    animation: wheel 1.6s var(--ease-out) infinite;
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(9px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /* ---------- Cena 4 ---------- */
  .hero__reveal {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: var(--header-h) var(--gutter) 0;
    pointer-events: none;
    visibility: hidden;
  }
  .hero__reveal p {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 4.4rem);
    font-weight: 650;
    line-height: 0.98;
    color: var(--brown);
  }
  .hero__reveal em {
    font-style: normal;
    font-size: 1.15em;
    color: var(--teal);
  }
  .hero__reveal-a {
    justify-self: start;
    max-width: 26vw;
  }
  .hero__reveal-b {
    justify-self: end;
    text-align: right;
    max-width: 26vw;
  }

  /* ---------- Progresso ---------- */
  .hero__progress {
    position: absolute;
    right: var(--gutter);
    bottom: 26px;
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 12px 0 0;
    list-style: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(73 43 39 / 0.45);
    opacity: 0;
  }
  .hero__progress li {
    transition: color 0.3s;
  }
  .hero__progress li.is-active {
    color: var(--brown);
  }
  .hero__progress-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    border-radius: 2px;
    background: rgb(73 43 39 / 0.15);
    overflow: hidden;
  }
  .hero__progress-bar span {
    position: absolute;
    inset: 0;
    background: var(--brown);
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (max-width: 920px) {
    .hero__progress {
      display: none;
    }
  }

  @media (max-width: 768px), (max-aspect-ratio: 4/5) {
    .hero__intro {
      justify-content: space-between;
      padding-top: calc(var(--header-h) + 18px);
      padding-bottom: 34px;
      text-align: center;
      align-items: center;
      gap: 0;
    }
    .hero__intro > * {
      max-width: 100%;
    }
    .hero__eyebrow {
      display: none;
    }
    .hero__title {
      font-size: clamp(2.5rem, 11.5vw, 4rem);
    }
    .hero__title .mask-line:nth-child(2),
    .hero__title .mask-line:nth-child(3) {
      display: inline;
    }
    .hero__sub {
      margin-top: auto;
      margin-bottom: 16px;
      max-width: 32ch;
      margin-inline: auto;
      font-size: 1rem;
    }
    .hero__ctas {
      justify-content: center;
      width: 100%;
    }
    .hero__ctas .btn {
      flex: 1 1 100%;
      min-height: 50px;
    }
    .hero__poster :global(img) {
      width: min(74vw, 42svh);
      transform: rotate(-8deg) translateY(-2svh);
    }
    .hero__hint {
      display: none;
    }
    .hero__reveal {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
      padding: calc(var(--header-h) + 8px) var(--gutter) 24px;
      text-align: center;
    }
    .hero__reveal-a,
    .hero__reveal-b {
      justify-self: center;
      text-align: center;
      max-width: none;
      font-size: clamp(2rem, 9vw, 2.8rem) !important;
    }
    .hero__reveal-a {
      align-self: start;
    }
    .hero__reveal-b {
      align-self: end;
    }
  }

  @media (max-height: 640px) and (max-width: 768px) {
    .hero__sub {
      display: none;
    }
  }

  /* Movimento reduzido: cena estática, conteúdo completo visível. */
  :global(.reduced-motion) .hero__hint,
  :global(.reduced-motion) .hero__progress {
    display: none;
  }
</style>
